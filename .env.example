# Blimber Meta / MCP (ChatGPT + Cursor)
BLIMBER_MCP_API_KEY=
# Opcional: secret separado para assinar tokens OAuth do plugin MCP (default: derivado da API key)
BLIMBER_MCP_OAUTH_JWT_SECRET=
# URL pública canônica para discovery OAuth (ex.: https://app.blimber.com.br ou túnel ngrok)
BLIMBER_MCP_PUBLIC_URL=
BLIMBER_MCP_ACTOR_USER_ID=
# Plugin MCP remoto: https://app.blimber.com.br/api/mcp — auth OAuth (ver docs/gpt-blimber-MCP-PLUGIN.md)

# Meta Graph API versions
# Ads / Marketing / OAuth marketing / publishers / organic / overview:
#   config.api_version → META_ADS_GRAPH_VERSION → META_GRAPH_VERSION → v25.0
# META_ADS_GRAPH_VERSION=v25.0
# META_GRAPH_VERSION=v25.0
# CAPI (CRM) usa só META_GRAPH_VERSION (default v25.0). WhatsApp Cloud permanece v21 hardcoded.